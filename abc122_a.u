main : '{IO, Exception} ()
main = do
  S = !readLine
  if S=="A" then
  printLine ("T")
  else if S=="T" then
  printLine ("A")
  else if S=="C" then
  printLine ("G")  
  else
  printLine ("C")
  
##########################################
[python]
b=str(input())
if b=='A':
    ans='T'
elif b=='T':
    ans='A'
elif b=='C':
    ans='G'
elif b=='G':
    ans='C'
print(ans)
